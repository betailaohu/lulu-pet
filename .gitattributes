# 统一换行符，避免 Windows 上提交后在 macOS runner 上出现
# "\r: command not found"、脚本 chmod 失败之类的问题
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.swift     text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.bat       text eol=crlf
gradlew     text eol=lf

# 二进制
*.png       binary
*.jpg       binary
*.jar       binary
*.apk       binary
*.ipa       binary
*.zip       binary
